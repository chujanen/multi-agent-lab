# Entra
LAB_TENANT_ID=                # your tenant GUID
LAB_API_CLIENT_ID=            # app registration lab-api (also the token audience)
LAB_API_CLIENT_SECRET=        # printed once by ops/setup_azure.sh --apply
LAB_WEB_CLIENT_ID=            # browser sign-in app registration (SPA, redirect http://localhost:5400/), full GUID
# Foundry
LAB_RESOURCE_GROUP=           # resource group of the Foundry account
LAB_FOUNDRY_ACCOUNT=          # Foundry (Cognitive Services) account name
LAB_FOUNDRY_PROJECT=          # project name inside that account
LAB_PROJECT_ENDPOINT=         # https://<account>.services.ai.azure.com/api/projects/<project>
LAB_MODEL_DEPLOYMENT=         # model deployment name used by the `model` test
LAB_ORCHESTRATOR_NAME=lab-orchestrator
LAB_FINANCE_NAME=lab-finance
LAB_RISK_NAME=lab-risk

# Telemetry (optional): when set, API and agents export traces to Application Insights
APPLICATIONINSIGHTS_CONNECTION_STRING=
LAB_APPINSIGHTS_RESOURCE_ID=   # ARM id of the App Insights resource; enables the "View in App Insights" link
